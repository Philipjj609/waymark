# Copy to .env in the MAIN checkout's root (never commit .env). Values here are placeholders.
# Worktrees and the web app read this one file (scripts/ops/env.mjs); host-set variables win.
# Check without printing secrets: pnpm paypal:check · pnpm nebius:check
# All payment work is PayPal SANDBOX only. Live credentials must never be used.

# --- PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox) ---
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
# Webhook id from the sandbox app's webhook subscription (used for signature verification).
# Leave empty until the app has a public HTTPS URL (#22, #28).
PAYPAL_WEBHOOK_ID=

# --- AI provider (ADR-0007: Nebius Token Factory, OpenAI-compatible API) ---
AI_PROVIDER=nebius
NEBIUS_API_BASE=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=replace-with-your-key
# Model ids are configuration, not code. Verify availability on your account first.
AI_MODEL_TUTOR=replace-with-model-id
AI_MODEL_VALIDATOR=replace-with-model-id

# --- Worlds (ADR-0005). memory = lost on restart (dev default); postgres = durable, needs DATABASE_URL.
WORLD_STORE=memory
DATABASE_URL=postgres://fle:fle@localhost:5432/fle_dev

# --- App ---
APP_BASE_URL=http://localhost:3000
# Exact Origin allowlist for state-changing requests (ADR-0011), comma-separated
APP_ORIGINS=http://localhost:3000
# Hosting proxy header carrying the client IP (per-IP rate limits). Leave empty unless verified.
CLIENT_IP_HEADER=
# Reserved (ADR-0011): unused today; sessions are opaque random ids, stored only as sha256.
SESSION_SECRET=
