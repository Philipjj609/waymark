{
  "$id": "https://schemas.finance-learning-economy.invalid/director.candidate.v1.json",
  "title": "director.candidate.v1",
  "x-contracts-version": "0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "director.candidate.v1"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "templateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "parameterSet": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "earliestDay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "latestDay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "targetActorIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 128,
        "pattern": "^act_[A-Za-z0-9_.:-]+$"
      }
    },
    "conceptTags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 128,
        "pattern": "^cpt_[A-Za-z0-9_.:-]+$"
      }
    },
    "eventOrigin": {
      "type": "string",
      "enum": [
        "CONSEQUENTIAL",
        "WORLD_DEVELOPMENT",
        "EDUCATIONAL"
      ]
    },
    "playerFacingDisclosure": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "recoveryOptions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selectionRationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "seed": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "candidateId",
    "templateId",
    "catalogVersion",
    "parameterSet",
    "earliestDay",
    "latestDay",
    "targetActorIds",
    "conceptTags",
    "eventOrigin",
    "playerFacingDisclosure",
    "recoveryOptions",
    "selectionRationale",
    "seed"
  ],
  "additionalProperties": false
}
