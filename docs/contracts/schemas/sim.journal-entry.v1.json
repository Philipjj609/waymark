{
  "$id": "https://schemas.finance-learning-economy.invalid/sim.journal-entry.v1.json",
  "title": "sim.journal-entry.v1",
  "x-contracts-version": "0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "journalId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^jnl_[A-Za-z0-9_.:-]+$"
    },
    "entityId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^ent_[A-Za-z0-9_.:-]+$"
    },
    "worldDay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "causationEventId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^evt_[A-Za-z0-9_.:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ruleVersion": {
      "type": "string",
      "minLength": 1
    },
    "memo": {
      "type": "string",
      "maxLength": 280
    },
    "lines": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^(ASSET|LIABILITY|EQUITY|REVENUE|EXPENSE):[A-Z][A-Za-z0-9]*$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "DEBIT",
              "CREDIT"
            ]
          },
          "amount": {
            "type": "object",
            "properties": {
              "amountMinor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "currency": {
                "type": "string",
                "enum": [
                  "EUR",
                  "USD",
                  "GBP",
                  "JPY"
                ]
              }
            },
            "required": [
              "amountMinor",
              "currency"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "account",
          "direction",
          "amount"
        ],
        "additionalProperties": false
      }
    },
    "reversesJournalId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^jnl_[A-Za-z0-9_.:-]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "journalId",
    "entityId",
    "worldDay",
    "causationEventId",
    "ruleVersion",
    "memo",
    "lines",
    "reversesJournalId"
  ],
  "additionalProperties": false
}
