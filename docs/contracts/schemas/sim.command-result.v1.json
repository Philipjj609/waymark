{
  "$id": "https://schemas.finance-learning-economy.invalid/sim.command-result.v1.json",
  "title": "sim.command-result.v1",
  "x-contracts-version": "0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "worldVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 128,
        "pattern": "^evt_[A-Za-z0-9_.:-]+$"
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "SCHEMA_INVALID",
                "WORLD_MISMATCH",
                "STALE_WORLD_VERSION",
                "FORBIDDEN_ORIGIN",
                "UNAUTHORIZED_ACTOR",
                "UNKNOWN_OBLIGATION",
                "OBLIGATION_NOT_PAYABLE",
                "OBLIGATION_NOT_DEFERRABLE",
                "INSUFFICIENT_FUNDS",
                "INVALID_TARGET_DAY",
                "BLOCKED_BY_DECISION",
                "EVENT_CAP_EXCEEDED",
                "INVALID_AMOUNT",
                "PROVIDER_EVENT_UNMAPPED",
                "PROVIDER_AMOUNT_MISMATCH",
                "PROVIDER_EVENT_NOT_SETTLING",
                "IDEMPOTENCY_CONFLICT"
              ]
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "commandId",
    "status",
    "worldVersion",
    "eventIds",
    "error"
  ],
  "additionalProperties": false
}
