{
  "$id": "https://schemas.finance-learning-economy.invalid/learning.evidence.v1.json",
  "title": "learning.evidence.v1",
  "x-contracts-version": "0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "learning.evidence.v1"
    },
    "packetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "learnerId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^lrn_[A-Za-z0-9_.:-]+$"
    },
    "worldId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^wld_[A-Za-z0-9_.:-]+$"
    },
    "worldVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 128,
        "pattern": "^evt_[A-Za-z0-9_.:-]+$"
      }
    },
    "conceptTags": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 128,
        "pattern": "^cpt_[A-Za-z0-9_.:-]+$"
      }
    },
    "decisionOptionsShown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "playerSelectedAction": {
      "type": [
        "string",
        "null"
      ]
    },
    "observedResultFacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertaintyFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "DELIBERATE_RISK_POSSIBLE",
          "SINGLE_OBSERVATION",
          "AMBIGUOUS_UI",
          "ARITHMETIC_SLIP_POSSIBLE"
        ]
      }
    },
    "ruleVersion": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "packetId",
    "learnerId",
    "worldId",
    "worldVersion",
    "eventIds",
    "conceptTags",
    "decisionOptionsShown",
    "playerSelectedAction",
    "observedResultFacts",
    "uncertaintyFlags",
    "ruleVersion"
  ],
  "additionalProperties": false
}
